{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "*.html?smol": [
                "../src/html-module.d.ts"
            ]
        }
    },
    "include": [
        "./**/*",
        "../src/html-module.d.ts"
    ]
}